# Virtual environment
.venv/

# Sensitive — never commit
.env
data/credentials.json
data/license.key

# SQLite databases
data/*.db
data/*.db-shm
data/*.db-wal

# Prediction snapshots and logs (pushed by collectors at runtime)
data/latest_prediction*.json
data/pred_log*.json

# Trained model files
data/*.pkl
data/*.json

# CSV data files
data/*.csv

# Python cache
__pycache__/
*.pyc
*.pyo

# Misc
*.log
rag_output.json
